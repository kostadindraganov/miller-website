# Google Sheets — server-side source for the lunch menu (never sent to the browser).
# The spreadsheet must be shared as "Anyone with the link → Viewer".
GOOGLE_API_KEY=
SPREAD_SHEET_ID=
# Sent as the Referer header — only matters if the API key is HTTP-referrer
# restricted; it must then be one of the key's allowed referrers.
SHEETS_REFERER=https://miller-bg.com
